    "at": 1795671480000,
    "updatedAt": 1795671480000,
    "text": "Before is cleaner. After is truer to him.",
    "kept": false
   },
   "at": 1795671000014
  },
  {
   "_id": "east-winds:messages:a2",
   "world": "east-winds",
   "table": "messages",
