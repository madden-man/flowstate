{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["vite/client", "vite-plugin-pwa/client", "node"]
  },
  "include": ["src", "test", "vite.config.ts", "playwright.config.ts", "design/motion/src", "design/motion/vite.config.ts", "design/energize/src", "design/energize/vite.config.ts", "design/values/src", "design/values/vite.config.ts", "design/tiers/src", "design/tiers/vite.config.ts", "design/mountain/src", "design/mountain/vite.config.ts", "design/tasks/src", "design/tasks/vite.config.ts"]
}
